# Copy this file to ".env" and fill in your key.
# Get a free Helius key at https://helius.dev

HELIUS_API_KEY=

# How often to collect data, in minutes.
#
# This also sets the finest timeframe the dashboard can offer: a window can
# never be shorter than one collection interval. At 5 minutes the page can
# show 5m / 1h / 6h / 24h; at 30 minutes the 5m button is greyed out because
# there is no data at that resolution.
#
#   5  = 288 pulls/day  -> 5m / 1h / 6h / 24h
#   30 = 48 pulls/day   -> 1h / 6h / 24h
INTERVAL_MINUTES=5

# How many seconds of each interval to try to read.
#
# pump.fun runs at 160-520 signatures/second (it doubled inside one afternoon
# during development) and Helius parses 100 per call, so reading a whole
# interval is not affordable. Haboob reads this many seconds of traffic and
# scales the rate-like numbers up to the full interval.
#
# This is a ceiling on TIME, not on cost. Cost is capped separately by
# MAX_SIGNATURES_PER_RUN in src/collector.js (6,000 signatures = ~66 calls
# per run whatever the chain is doing). When traffic is heavy the cap bites
# first and the run covers less than SAMPLE_SECONDS - the collector says so,
# and scales from the span it actually read, so runs stay comparable.
#
# Measured with a 5-minute interval: ~66 calls/run -> ~19,000/day, 58% of the
# free tier (~33,000/day), with the web server's window refresh adding ~1,700.
# Lower MAX_SIGNATURES_PER_RUN if you want more headroom; raise it if you have
# a paid plan and want a wider sample.
SAMPLE_SECONDS=30

# The pump.fun program on Solana. Verify before trusting live data.
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
