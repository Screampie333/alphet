# Copy this file to ".env" and fill in your key.
# Get a free Helius key at https://helius.dev

HELIUS_API_KEY=

# How often to collect data, in minutes.
#
# This also sets the finest timeframe the dashboard can offer: a window can
# never be shorter than one collection interval. At 5 minutes the page can
# show 5m / 1h / 6h / 24h; at 30 minutes the 5m button is greyed out because
# there is no data at that resolution.
#
#   5  = 288 pulls/day  -> 5m / 1h / 6h / 24h
#   30 = 48 pulls/day   -> 1h / 6h / 24h
INTERVAL_MINUTES=5

# How many seconds of each interval to actually read.
#
# pump.fun runs at roughly 50-195 signatures/second and Helius parses 100 per
# call, so reading a whole interval is not affordable. Haboob reads this many
# seconds of traffic and scales the rate-like numbers up to the full interval.
#
# Pair it with the interval to stay inside the free tier (~33k credits/day):
#
#   interval 5,  sample 30   ->  ~5k-19k calls/day   (safe)
#   interval 5,  sample 120  ->  ~18k-69k calls/day  (over budget at the top)
#   interval 30, sample 120  ->  ~3k-12k calls/day   (safe)
#
# Changing this makes old snapshots non-comparable with new ones, because the
# scale factor changes. Pick a value before you start collecting and leave it.
SAMPLE_SECONDS=30

# The pump.fun program on Solana. Verify before trusting live data.
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
