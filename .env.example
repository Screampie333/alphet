# Copy this file to ".env" and adjust if you need to.
#
# Every value here has a working default. Alphet runs live against Robinhood
# Chain out of the box - there is no API key to obtain and no contract address
# to look up. `npm run mock` needs no network at all.

# --- Robinhood Chain ---
# An Arbitrum Orbit L2, chain id 4663. The public endpoint below is verified
# working, but it is shared and rate-limits under load - point this at your own
# node or a provider endpoint if runs start backing off.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_CHAIN_ID=4663
RHC_CHAIN_NAME=Robinhood Chain
RHC_EXPLORER_URL=
# --- Blockscout (the official RHC indexer) ---
# Optional, but it is what makes two of the four metrics work at all.
#
# A public RPC cannot enumerate the holders of a busy token - PONS had 21,658
# receivers in 24h against a 400-candidate cap - so without a key here, holder
# distribution reads "not measurable" for every large token, and developer
# track record falls back to a deployer lookup that misses ~3 times in 4.
#
# Free key: https://dev.blockscout.com  (5 req/s, 100k credits/day).
# A 150-token run spends roughly 600.
BLOCKSCOUT_API_KEY=


# --- Discovery ---
# GeckoTerminal's slug for this chain, and how much of each feed to read.
# One page is 20 pools. New pools catch this morning's launches; top pools
# catch where the money already is.
GT_NETWORK=robinhood
NEW_POOL_PAGES=3
# Venues swept per run, resuming where the last stopped (0 = all).
# Rotating costs no coverage: what it finds is remembered and re-priced every
# run. 14 covers all ~40 venues within three runs.
DEX_SWEEP_SIZE=14
DEX_PAGES=2
TOP_POOL_PAGES=2

# Extra tokens to treat as quote assets and never score. Quote tokens are
# detected from the feed automatically, so this is only for anything that
# slips through.
QUOTE_TOKENS=

# --- Collection ---
# Holder distribution is the expensive metric: no API on this chain will answer
# it, so it is rebuilt from each token's Transfer log plus one balanceOf per
# candidate wallet. Every run prints what it actually spent - watch that number
# before raising MAX_TOKENS_PER_RUN.
INTERVAL_MINUTES=360
LOOKBACK_HOURS=24
# 0 = no cap: score every tradeable token discovery finds.
MAX_TOKENS_PER_RUN=0
MAX_HOLDER_CANDIDATES=400
READ_CACHE_MINUTES=43200
NEW_TOKEN_HOURS=24

# Tokens per run allowed to use Blockscout, highest volume first.
# Free tier is 100k credits/month at 20 credits per call = 5,000 calls total.
INDEXER_TOKEN_LIMIT=100

# Pools thinner than this are skipped entirely - below a few hundred dollars a
# single trade moves the price, so volume and buy/sell split are both noise.
# 0 = no floor: score every token that has a pool at all.
MIN_LIQUIDITY_USD=0

# Trades a window needs before buy/sell split and volume-per-holder mean
# anything. Below this the rug-signal metric reports nothing rather than
# scoring an untraded token as healthy.
MIN_TRADES_FOR_SIGNAL=10

# --- RPC tuning ---
# Set by watching the public endpoint 429. Robinhood Chain runs at about ten
# blocks a second, so a day is ~850,000 blocks; chain.js splits eth_getLogs
# adaptively and LOG_PAGE_BLOCKS is only the starting span.
# Raise the batch and drop the delay if you move to your own node.
RPC_BATCH_SIZE=20
RPC_MIN_DELAY_MS=250
LOG_PAGE_BLOCKS=100000

# Comma-separated locker contracts. LP tokens sitting in one of these count as
# locked rather than withdrawable. Burn addresses are already built in.
RHC_LOCKERS=

# A token at or above this score is Alpha; below it is Beta.
ALPHA_CUTOFF=55

# Timezone every timestamp is displayed in, so the site, the console report and
# npm run history can never disagree about what day a reading belongs to.
DISPLAY_TZ=America/Chicago

PORT=3000
